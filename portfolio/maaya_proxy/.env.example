# Primary provider
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional fallback provider for the Maaya LLM gateway
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash

# Provider order. Maaya tries each configured provider before falling back locally.
MAAYA_LLM_PROVIDERS=groq,gemini
MAAYA_LLM_TIMEOUT=18
MAAYA_GATEWAY_RETRIES=1
MAAYA_GATEWAY_RETRY_DELAY=0.25

# Local development only. Do not set PORT manually on Render.
PORT=8008

# Optional feedback form storage. Keep the real URI only in local .env or Render env vars.
MONGODB_URI=your_mongodb_connection_string
MONGODB_DATABASE=portfolio
MONGODB_FEEDBACK_COLLECTION=viewer_feedback

# Optional second-layer safety classifier. Uses the Groq key above.
LLAMA_GUARD_ENABLED=1
LLAMA_GUARD_MODEL=openai/gpt-oss-safeguard-20
LLAMA_GUARD_TIMEOUT=12

# Optional redacted LangSmith observability. Keep the real key only in local .env or Render env vars.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=maaya-portfolio-assistant
